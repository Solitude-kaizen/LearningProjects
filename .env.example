# Choose the AI provider.
# Valid values: groq, ollama, openai
AI_PROVIDER=groq

# Required only when using Groq.
GROQ_API_KEY=your_groq_api_key_here

# Required only when using OpenAI.
OPENAI_API_KEY=your_openai_api_key_here

# Ollama runs locally and does not require an API key.

# Optional daily read-only improvement research.
# This uses Groq Compound Mini web search and may use billable tools.
# Confirm your Groq account limits and billing before enabling it.
KAIZEN_DISCOVERY_ENABLED=false

# Optional zero-cost public research collector.
# Reads public metadata from GitHub, Hacker News, arXiv, and a
# curated YouTube channel feed. It does not call a paid AI model.
# Keep disabled to prevent automatic network access at startup.
# Manual collection remains available from the CLI.
SK_RESEARCH_ENABLED=false

# Legacy setting for explicit callers of run_controlled_learning_cycle.
# Normal CLI startup ignores this setting and never prepares lessons.
# Use the optional Learning Guide from the menu when you want to study.
# The legacy helper retains its daily limit and does not train a model.
SK_CONTINUOUS_LEARNING_ENABLED=false
